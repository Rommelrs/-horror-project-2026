  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Khalid,\n\nYou already know why Al-Sarab still bothers you.\n\nYou keep
    telling yourself that you remember what happened.\n\nYou don\u2019t.\n\nThere\u2019s
    something you missed.\n\nSomething about the boy.\n\nGo back to Al-Sarab.\n\nStart
    from the places you both used to know.\n\nThe grocery.\n\nThe streets near your
    house.\n\nFollow what you remember, even if it doesn\u2019t make sense at first.\n\nAnd
    when you start seeing him...\n\nDon\u2019t run away this time.\n\nYou\u2019ve
    done that enough."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
