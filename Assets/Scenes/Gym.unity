--- !u!114 &839903358
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 839903356}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Yeah\u2026 this one is definitely Adel\u2019s.\n\nThose faces gave it
    away. Same eyes. Same teeth. Same angry little creatures marching in a line.\n\nI
    used to point that out to him all the time. \u201CAdel, why do they all look
    the same?\u201D\n\nHe never got mad. He\u2019d just stare at the page, nod like
    I gave him some serious advice, then add a scar\u2026 or a different eye\u2026
    or make one taller than the rest.\n\nOne day I asked him, \u201CWho\u2019s the
    guy with the gun?\u201D\n\nHe got excited and said, \u201CHe\u2019s saving his
    little brother from the monsters.\u201D\n\nI laughed, it sounded so stupid back
    then.\n\n\nNow I wish I asked him more about it."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
