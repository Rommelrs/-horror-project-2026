  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "At home it\u2019s different. Home is quiet in the bad way. the air is
    always heavy and I\u2019m always waiting for something to happen even when nothing
    is happening. I hate that feeling.\n\nIn the park, I don\u2019t think about any
    of that.\n\nI just sit there, hear the wind in the trees, and for a little while\u2026
    it feels like I\u2019m not trapped in my own life.\n\nSometimes I really want
    to sleep in the park but don't want people to pity me."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
