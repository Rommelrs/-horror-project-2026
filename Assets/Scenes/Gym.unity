  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I woke up because of a door slamming so hard it shook the glass.\n\n\nI
    looked out. A man burst out of the house and ran like he was being chased. Not
    drunk. Not lost. Afraid. He kept looking back over his shoulder like he\u2019d
    done something terrible.\n\n\nHe dropped his keys, cursed under his breath, hands
    shaking. Got in the car, started it, and peeled out without even turning the
    lights on at first.\n\nHe drove off fast and that kinda scared me"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
