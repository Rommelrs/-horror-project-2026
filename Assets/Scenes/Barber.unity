  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "But there is no one here...\n\nNo voices\nNo footsteps \nNo answer\n\nOnly
    the silence I once asked for\nMaybe this is what I earned\nI said I wanted to
    be all alone, and now I understand what those words really meant\n\nI miss my
    family\n\nI miss my home\n\nI miss my mother\u2019s rice and chicken and the
    special soup she makes\nI miss the noise my brother's daughter makes\nI miss
    even the smallest things I once took for granted\n\nIf anyone finds this message,
    and if by god's mercy my family is still somewhere beyond this silence, tell
    them I was wrong\n\nTell them I finally understood too late\nTell them I loved
    them\n\nAnd I always will.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
