  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "One of Adel\u2019s Drawings\n\nThis one felt different.\n\nI remember
    asking Adel why the man with the gun looked so angry this time.\n\nHe told me,
    \u201CBecause his little brother died. The monsters ate him\u2026 so now he\u2019s
    surrounded by rage.\u201D\n\nI remember just staring at him after that.\n\nI
    always thought children gave their stories happy endings. Heroes win, monsters
    lose, everyone goes home.\n\nBut Adel\u2019s little adventures didn\u2019t always
    end like that.\n\nSometimes he said things that made him feel older than he was.\n\nI
    never minded dark stories\u2026 but hearing them come from a kid always felt
    strange."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
