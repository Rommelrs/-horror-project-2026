    m_Key: the monsters... they...
    m_Metadata:
      m_Items: []
  - m_Id: 103273417048641549
    m_Key: W-we should definitely escape this town, man,
    m_Metadata:
      m_Items: []
  - m_Id: 103273417048641550
    m_Key: "it\u2019s not normal anymo\u2014"
    m_Metadata:
