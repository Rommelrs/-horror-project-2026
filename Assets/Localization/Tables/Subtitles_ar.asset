      m_Items: []
  - m_Id: 160676237312
    m_Localized: "\uFEB8\uFEB7\uFE91\uFEE2\uFED7\uFEEC\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 176799141888
    m_Localized: "!\uFEDE\uFED4\uFED8\uFEE3 \u0628\uFE8E\uFE92\uFEDF\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 204322164736
    m_Localized: "\u062C\uFEAE\uFEA8\uFEE3 \uFBFD\uFED8\uFEDF\u0627 \uFEDE\uFEC0\uFED3\uFEFB\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 225276907520
    m_Localized: "\u061F\u061F\u0642\uFEEE\uFEE0\uFEA8\uFEE4\uFEDF\u0627 \u0627\uFEAC\uFEEB
      \uFEB6\uFEF3\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 249083777024
    m_Localized: "\uFEBA\uFED7\uFE8E\uFEE7 \uFEF2\uFEB7 \uFEEA\uFEF4\uFED3 \u0632\uFEEE\uFEF4\uFED4\uFEDF\u0627
      \u0642\u0648\uFEAA\uFEE8\uFEBB"
    m_Metadata:
      m_Items: []
  - m_Id: 280197124096
    m_Localized: "\uFEE6\uFEF4\uFEA4\uFEDF\u0627 \uFE94\uFED7\uFE8E\uFEC4\uFEDF\u0627
      \uFE8E\uFEE8\uFECC\uFE9F\u0631 "
    m_Metadata:
      m_Items: []
  - m_Id: 302393380864
    m_Localized: "\uFE94\uFECC\uFEC4\uFED8\uFEDF\u0627 \u064A\uFEAA\uFEE8\uFECB \uFEEA\uFEE7\u0627
      \uFEAA\uFED8\uFE98\uFECB\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 354847346688
    m_Localized: "\u0632\uFEEE\uFEF4\uFED4\uFEDF\u0627 \u062A\uFEAC\uFEA7\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 373528776704
    m_Localized: "\uFEEA\uFEE0\uFEE4\uFECC\uFE98\uFEB3\u0627 \uFEAE\uFEC4\uFEBF\u0627
      \uFE8E\uFEE3 \uFBFD\uFEE8\uFEE4\uFE97\u0627 \u061F\uFE8E\uFEE8\uFEEB \u062D\uFEFC\uFEB4\uFEDF\uFE8E\uFEEB
      \u0628\uFE8E\uFE9F \uFEB6\uFEF3\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 394613542912
    m_Localized: "\u0642\uFEEE\uFEB4\uFE98\uFEE0\uFEDF \uFE90\uFEB3\uFE8E\uFEE8\uFEE3
      \uFE90\uFEE3 \uFE96\uFED7\uFEEE\uFEDF\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 415320821760
    m_Localized: "\u061F!\u0627\uFEAC\uFEEB \uFEB6\uFEF3\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 95623907048738816
    m_Localized: "\u0644\u0627 \u0634\u064A\u0621 \u0645\u0641\u064A\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 95623907078098944
    m_Localized: "\u0644\u0627 \u0634\u064A\u0621 \u0645\u0641\u064A\u062F \u0647\u0646\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 95623907078098945
    m_Localized: "\u0644\u0627 \u064A\u0648\u062C\u062F \u0641\u064A\u0648\u0632
      \u0647\u0646\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 95623907078098946
    m_Localized: "\u0644\u0627 \u064A\u0648\u062C\u062F \u0641\u064A\u0648\u0632
      \u0647\u0646\u0627 \u0623\u064A\u0636\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 95623907078098947
    m_Localized: "\u0645\u0627 \u0632\u0644\u062A \u0644\u0627 \u0623\u062C\u062F
      \u0641\u064A\u0648\u0632\u064B\u0627..."
    m_Metadata:
      m_Items: []
  - m_Id: 95623907078098948
    m_Localized: "\u0644\u064A\u0633 \u0647\u0646\u0627. \u0623\u0643\u0645\u0644
      \u0627\u0644\u0628\u062D\u062B."
    m_Metadata:
      m_Items: []
  - m_Id: 95628046109560832
    m_Localized: "\u0627\u0644\u0628\u0627\u0628 \u0644\u0627 \u064A\u0646\u0641\u062A\u062D."
    m_Metadata:
      m_Items: []
  - m_Id: 99703744835145728
    m_Localized: "\u0644\u064A\u0633 \u0644\u062F\u064A \u0648\u0642\u062A \u0644\u0647\u0630\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 99722716024459264
    m_Localized: "\u0625\u0646\u0647 \u0645\u0642\u0641\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 99722716078985216
    m_Localized: "\u062A\u0645 \u0641\u062A\u062D \u0627\u0644\u0642\u0641\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 101515578273746944
    m_Localized: "\u0644\u0627 \u064A\u0641\u062A\u062D \u0645\u0646 \u0647\u0630\u0627
      \u0627\u0644\u062C\u0627\u0646\u0628."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213255114752
    m_Localized: "\u0644\u0627 \u062A\u0637\u0644\u0642! \u0644\u0627 \u062A\u0637\u0644\u0642!
      \u0645\u0648 \u0623\u0646\u0627\u060C \u0648\u0627\u0644\u0644\u0647!"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669184
    m_Localized: "...\u0633\u0648\u064A\u062A \u0625\u064A\u0634\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669185
    m_Localized: "\u0641\u064A \u0648\u0627\u062C\u062F \u0645\u0646\u0647\u0645
      \u0628\u0648\u062C\u0647\u064A... \u0628\u0633 \u0623\u0646\u0627 \u0645\u0648
      \u0645\u0646\u0647\u0645! \u062A\u0643\u0641\u0649!"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669186
    m_Localized: "\u0627\u0646\u062A \u0642\u0641\u0644\u062A \u0639\u0644\u064A
      \u0627\u0644\u0628\u0642\u0627\u0644\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669187
    m_Localized: "\u0644\u0627 \u0644\u0627 \u0644\u0627. \u0647\u0630\u0627\u0643
      \u0648\u0627\u062D\u062F \u0645\u0646\u0647\u0645. \u0634\u0648\u0641\u060C
      \u0645\u0627 \u0645\u0639\u064A \u0633\u0643\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669188
    m_Localized: "\u0645\u064A\u0646 \u0627\u0646\u062A\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669189
    m_Localized: "\u0627\u0645\u0645..."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669190
    m_Localized: "\u0623\u0646\u0627 \u062E\u0627\u0644\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669191
    m_Localized: "...\u0645\u0648 \u0645\u0647\u0645 \u0645\u064A\u0646 \u0623\u0646\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669192
    m_Localized: "\u0648\u0634 \u0635\u0627\u0631 \u0647\u0646\u064A\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669193
    m_Localized: "\u0645\u062D\u062F \u064A\u062F\u0631\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669194
    m_Localized: "\u0644\u0627 \u062A\u0642\u0631\u0627 \u0647\u0630\u064A \u0628\u0635\u0648\u062A
      \u0639\u0627\u0644\u064A. \u062F\u0627\u064A\u0645\u064B\u0627 \u0641\u064A
      \u0634\u064A \u064A\u0631\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669195
    m_Localized: "\u0623\u062F\u0648\u0631 \u0648\u0644\u062F. \u0645\u0639\u0627\u0647
      \u0634\u0646\u0637\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669196
    m_Localized: "...\u0648\u0644\u062F\u0643\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669197
    m_Localized: "...\u0623\u062E\u0648\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669198
    m_Localized: "\u0627\u0644\u0644\u0647 \u064A\u0639\u064A\u0646\u0643 \u062A\u0644\u0642\u0627\u0647.
      \u0631\u0627\u062D \u0635\u0648\u0628 \u0627\u0644\u0645\u062F\u0631\u0633\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669199
    m_Localized: "\u0628\u0633 \u0644\u0627 \u062A\u062F\u062E\u0644 \u0627\u0644\u0633\u0643\u0629
      \u0627\u0644\u0644\u064A \u0647\u0646\u0627\u0643. \u0627\u0644\u0646\u0627\u0633
      \u064A\u062F\u062E\u0644\u0648\u0646. \u0648\u0645\u0627 \u064A\u0637\u0644\u0639\u0648\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669200
    m_Localized: "\u0644\u0627\u0632\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669201
    m_Localized: "\u0644\u0627. \u0645\u0648 \u0644\u0627\u0632\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669202
    m_Localized: "\u0648\u062E\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669203
    m_Localized: "\u0645\u0627 \u062A\u0633\u0645\u0639\u061F! \u0623\u0642\u0648\u0644\u0643
      \u0628\u062A\u0645\u0648\u062A \u0647\u0646\u0627\u0643!"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669204
    m_Localized: "\u0641\u0643\u0646\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669205
    m_Localized: "\u0639\u0634\u0627\u0646 \u0625\u064A\u0634\u061F! \u0639\u0634\u0627\u0646
      \u0648\u0644\u062F \u064A\u0645\u0643\u0646 \u0623\u0635\u0644\u064B\u0627\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669206
    m_Localized: "\u0627\u0644\u0644\u0647 \u064A\u0639\u064A\u0646\u0643 \u062A\u0644\u0642\u0627\u0647.
      \u0648\u064A\u0646 \u0634\u0641\u062A\u0647\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669207
    m_Localized: "\u0641\u064A \u0627\u0644\u0633\u0643\u0629 \u0627\u0644\u0644\u064A
      \u0639\u0646\u062F \u0627\u0644\u0645\u062F\u0631\u0633\u0629. \u062A\u0648\u0646\u064A
      \u0637\u0627\u0644\u0639 \u0645\u0646\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669208
    m_Localized: "...\u062F\u062E\u0644\u062A \u0647\u0646\u0627\u0643\u061F \u0648\u0637\u0644\u0639\u062A\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669209
    m_Localized: "\u0625\u064A\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669210
    m_Localized: "\u0645\u062D\u062F \u064A\u0637\u0644\u0639 \u0645\u0646 \u0647\u0646\u0627\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669211
    m_Localized: "\u0623\u0646\u0627 \u0637\u0644\u0639\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669212
    m_Localized: "...\u0623\u062C\u0644 \u0641\u064A \u0634\u064A \u062E\u0644\u0627\u0643
      \u062A\u0637\u0644\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669213
    m_Localized: "\u0628\u0631\u062C\u0639. \u0627\u0644\u0648\u0644\u062F \u0631\u0627\u062D
      \u0645\u0646 \u0647\u0646\u0627\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669214
    m_Localized: "\u0644\u0627. \u0627\u0644\u0644\u064A \u062E\u0644\u0627\u0643
      \u062A\u0637\u0644\u0639 \u0645\u0627 \u0631\u0627\u062D \u064A\u0633\u0648\u064A\u0647\u0627
      \u0645\u0631\u062A\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669215
    m_Localized: "\u0645\u0627 \u062A\u0633\u0645\u0639\u061F! \u0627\u0646\u062A
      \u0645\u062D\u0638\u0648\u0638! \u0628\u062A\u0645\u0648\u062A \u0647\u0646\u0627\u0643!"
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669216
    m_Localized: "...\u062E\u0644\u0627\u0635. \u0631\u0648\u062D. \u0644\u0627 \u062A\u0642\u0648\u0644
      \u0645\u0627 \u062D\u0630\u0631\u062A\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 102624213288669217
    m_Localized: "\u0645\u0627 \u0623\u0642\u062F\u0631 \u0623\u0642\u0639\u062F
      \u0647\u0646\u064A."
    m_Metadata:
      m_Items: []
  references:
