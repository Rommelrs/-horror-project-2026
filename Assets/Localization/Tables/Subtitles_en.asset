  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 6b2f63a3b85184e42a4b65beed82f262, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 40517816320
    m_Localized: Looks like the cash register requires power
    m_Metadata:
      m_Items: []
  - m_Id: 65859801088
    m_Localized: it's the map of AL-Sarab city
    m_Metadata:
      m_Items: []
  - m_Id: 84943884288
    m_Localized: And also a key... not sure what for
    m_Metadata:
      m_Items: []
  - m_Id: 107052060672
    m_Localized: It might be a good idea to leave the city but I don't think I can
    m_Metadata:
      m_Items: []
  - m_Id: 124542308352
    m_Localized: There's a lock here
    m_Metadata:
      m_Items: []
  - m_Id: 145136340992
    m_Localized: I might be able to shoot it
    m_Metadata:
      m_Items: []
  - m_Id: 160676237312
    m_Localized: What the...?
    m_Metadata:
      m_Items: []
  - m_Id: 176799141888
    m_Localized: The door is locked!
    m_Metadata:
      m_Items: []
  - m_Id: 204322164736
    m_Localized: I better find a way out
    m_Metadata:
      m_Items: []
  - m_Id: 225276907520
    m_Localized: What kind of monster is this?
    m_Metadata:
      m_Items: []
  - m_Id: 249083777024
    m_Localized: This fusebox misses something
    m_Metadata:
      m_Items: []
  - m_Id: 280197124096
    m_Localized: The power is back on
    m_Metadata:
      m_Items: []
  - m_Id: 302393380864
    m_Localized: I think I have that something
    m_Metadata:
      m_Items: []
  - m_Id: 354847346688
    m_Localized: I got the fuse
    m_Metadata:
      m_Items: []
  - m_Id: 373528776704
    m_Localized: It's a gun, I hope I won't have to use it
    m_Metadata:
      m_Items: []
  - m_Id: 394613542912
    m_Localized: Don't think it's time for shopping
    m_Metadata:
      m_Items: []
  - m_Id: 415320821760
    m_Localized: What the hell is this?
    m_Metadata:
      m_Items: []
  - m_Id: 18163424864030720
    m_Localized: There's some blood on the wall
    m_Metadata:
      m_Items: []
  - m_Id: 18189612328210432
    m_Localized: There's a hidden code now
    m_Metadata:
      m_Items: []
  - m_Id: 18490172310867968
    m_Localized: I applied duct tape
    m_Metadata:
      m_Items: []
  - m_Id: 18497253260709888
    m_Localized: what's this hole in the wall?
    m_Metadata:
      m_Items: []
  - m_Id: 18501458432151552
    m_Localized: What is this hole?
    m_Metadata:
      m_Items: []
  - m_Id: 18501590380761088
    m_Localized: For some reason, this wall makes me uncomfortable...
    m_Metadata:
      m_Items: []
  - m_Id: 18505188309258240
    m_Localized: I can't stand near this hole anymore!!
    m_Metadata:
      m_Items: []
  - m_Id: 18509749623246848
    m_Localized: Seriously who keeps doing this?!!
    m_Metadata:
      m_Items: []
  - m_Id: 18509874538008576
    m_Localized: Just what happened to this town??
    m_Metadata:
      m_Items: []
  - m_Id: 18664198488510464
    m_Localized: What the...?!!
    m_Metadata:
      m_Items: []
  - m_Id: 18664326683217920
    m_Localized: The door is locked!!
    m_Metadata:
      m_Items: []
  - m_Id: 19245358293766144
    m_Localized: That message I got while driving
    m_Metadata:
      m_Items: []
  - m_Id: 19376876794204160
    m_Localized: "I couldn\u2019t sleep peacefully after it."
    m_Metadata:
      m_Items: []
  - m_Id: 19376980385124352
    m_Localized: "Something kept telling me: go back\u2026 go back\u2026 go back. "
    m_Metadata:
      m_Items: []
  - m_Id: 19534276838871040
    m_Localized: That message I got while driving
    m_Metadata:
      m_Items: []
  - m_Id: 19534538366308352
    m_Localized: That message I got while driving
    m_Metadata:
      m_Items: []
  - m_Id: 19534881380683776
    m_Localized: And now it's to see who's playing with me
    m_Metadata:
      m_Items: []
  - m_Id: 19545459989991424
    m_Localized: "Something kept telling me: go back\u2026 go back\u2026 go back."
    m_Metadata:
      m_Items: []
  - m_Id: 19611707243286528
    m_Localized: This cloth is blocking the way
    m_Metadata:
      m_Items: []
  - m_Id: 19612135179735040
    m_Localized: This is really getting creepy
    m_Metadata:
      m_Items: []
  - m_Id: 19701127061491712
    m_Localized: Oh my god....
    m_Metadata:
      m_Items: []
  - m_Id: 19701369194467328
    m_Localized: What is that in front of me?!
    m_Metadata:
      m_Items: []
  - m_Id: 20452314098487296
    m_Localized: '" Where''s your father? "'
    m_Metadata:
      m_Items: []
  - m_Id: 20452670605938688
    m_Localized: I don't like this
    m_Metadata:
      m_Items: []
  - m_Id: 20459657339129856
    m_Localized: The power is back on
    m_Metadata:
      m_Items: []
  - m_Id: 20733183790993408
    m_Localized: This " X " feels familiar
    m_Metadata:
      m_Items: []
  - m_Id: 20736410922045440
    m_Localized: I don't feel good...
    m_Metadata:
      m_Items: []
  - m_Id: 21498134147158016
    m_Localized: This paper consists of multiple phone numbers
    m_Metadata:
      m_Items: []
  - m_Id: 21498282038317056
    m_Localized: it looks like family numbers...
    m_Metadata:
      m_Items: []
  - m_Id: 21498526889201664
    m_Localized: It's an old payphone
    m_Metadata:
      m_Items: []
  - m_Id: 21498757806608384
    m_Localized: There are some coins here
    m_Metadata:
      m_Items: []
  - m_Id: 21498903596421120
    m_Localized: Maybe someone was in a rush
    m_Metadata:
      m_Items: []
  - m_Id: 21499335899140096
    m_Localized: A flashlight... doesn't look usable though
    m_Metadata:
      m_Items: []
  - m_Id: 21500109693702144
    m_Localized: Family photo too...
    m_Metadata:
      m_Items: []
  - m_Id: 21500880510308352
    m_Localized: Bunch of crayons
    m_Metadata:
      m_Items: []
  - m_Id: 21500966665506816
    m_Localized: Someone used to love them
    m_Metadata:
      m_Items: []
  - m_Id: 21501908462915584
    m_Localized: Chicken breast and some soup
    m_Metadata:
      m_Items: []
  - m_Id: 21502079259168768
    m_Localized: There's also a grocery list
    m_Metadata:
      m_Items: []
  - m_Id: 21501385080885248
    m_Localized: Looks like some sort of an apology message
    m_Metadata:
      m_Items: []
  - m_Id: 21503374292471808
    m_Localized: it stop halfway through
    m_Metadata:
      m_Items: []
  - m_Id: 21505266682744832
    m_Localized: it's a plastic tray
    m_Metadata:
      m_Items: []
  - m_Id: 22635200981553152
    m_Localized: These ropes are blocking the way
    m_Metadata:
      m_Items: []
  - m_Id: 22637075227267072
    m_Localized: I burned the ropes successfully
    m_Metadata:
      m_Items: []
  - m_Id: 23308273078554624
    m_Localized: Finding a prayer bead
    m_Metadata:
      m_Items: []
  - m_Id: 23308372491948032
    m_Localized: Makes me feel comfortable
    m_Metadata:
      m_Items: []
  - m_Id: 23348844052664320
    m_Localized: This bridge looks broken
    m_Metadata:
      m_Items: []
  - m_Id: 23349023367548928
    m_Localized: Now I can pass here
    m_Metadata:
      m_Items: []
  - m_Id: 23375690043543552
    m_Localized: Someone drilled a hole here
    m_Metadata:
      m_Items: []
  - m_Id: 23375867563266048
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 24400941036654592
    m_Localized: it's locked
    m_Metadata:
      m_Items: []
  - m_Id: 27568915591516160
    m_Localized: That message I got while I was sleeping in the car....
    m_Metadata:
      m_Items: []
  - m_Id: 27569054854991872
    m_Localized: "I couldn\u2019t sleep peacefully because of it."
    m_Metadata:
      m_Items: []
  - m_Id: 27569120613289984
    m_Localized: I've always wanted to come back
    m_Metadata:
      m_Items: []
  - m_Id: 27569154608123904
    m_Localized: Everytime, I keep thinking and telling myself...
    m_Metadata:
      m_Items: []
  - m_Id: 27569202452549632
    m_Localized: That I need to confirm this
    m_Metadata:
      m_Items: []
  - m_Id: 27569247839113216
    m_Localized: ' And this message, was the right excuse to come back'
    m_Metadata:
      m_Items: []
  - m_Id: 27569334199832576
    m_Localized: Al-Sarab city
    m_Metadata:
      m_Items: []
  - m_Id: 27569373928280064
    m_Localized: This city carries memories I can never forget.
    m_Metadata:
      m_Items: []
  - m_Id: 27569417788116992
    m_Localized: Great thing it's away from noise
    m_Metadata:
      m_Items: []
  - m_Id: 27569462746861568
    m_Localized: You can only hear maintenance sounds.
    m_Metadata:
      m_Items: []
  - m_Id: 27569493688242176
    m_Localized: People playing soccer
    m_Metadata:
      m_Items: []
  - m_Id: 27569523266473984
    m_Localized: Whispers of the neighbors
    m_Metadata:
      m_Items: []
  - m_Id: 27569571438055424
    m_Localized: But sometimes... you can hear people ruin the peace by their cars
    m_Metadata:
      m_Items: []
  - m_Id: 27569652375539712
    m_Localized: And I honestly don't respect them but hey.. what to do right?
    m_Metadata:
      m_Items: []
  - m_Id: 27569758130720768
    m_Localized: All i'm wishing for... is that everything goes okay
    m_Metadata:
      m_Items: []
  - m_Id: 27589643942547456
    m_Localized: Barber Shop?
    m_Metadata:
      m_Items: []
  - m_Id: 27589743213334528
    m_Localized: This is where im heading then...
    m_Metadata:
      m_Items: []
  - m_Id: 49671519486136320
    m_Localized: The door should be opened now
    m_Metadata:
      m_Items: []
  - m_Id: 49675856169979904
    m_Localized: There might be something important before I leave
    m_Metadata:
      m_Items: []
  - m_Id: 54718542845366272
    m_Localized: This drawing style is very familiar
    m_Metadata:
      m_Items: []
  - m_Id: 54723337136164864
    m_Localized: Maybe a child used it to find his way to home
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
